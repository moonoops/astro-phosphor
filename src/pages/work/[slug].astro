---
import { render } from "astro:content";
import type { InferGetStaticPropsType } from "astro";
import DesktopLayout from "../../layouts/DesktopLayout.astro";
import WindowFrame from "../../components/os/Window";
import PixelIcon from "../../components/os/PixelIcon";
import WorkIndex from "../../components/work/WorkIndex.astro";
import { getProjects } from "../../components/work/projects";
import PhosphorPicture from "../../components/ui/PhosphorPicture.astro";
import GalleryLightbox, { type GalleryItem } from "../../components/interactive/GalleryLightbox";
import { site, work } from "../../data/page-copy.json";
import { withBase } from "../../site";

export async function getStaticPaths() {
  const projects = await getProjects();

  return projects.map((project, index) => ({
    params: { slug: project.id },
    props: {
      project,
      projects,
      nextProject: projects.length > 1 ? projects[(index + 1) % projects.length] : undefined,
    },
  }));
}

const { project, projects, nextProject } = Astro.props as InferGetStaticPropsType<typeof getStaticPaths>;
const { data } = project;
const { Content } = await render(project);
const rawMedia: GalleryItem[] = data.gallery?.length ? data.gallery : [{ src: data.thumbnail, alt: data.thumbnailAlt }];
const media: GalleryItem[] = rawMedia.map((item) => ({ ...item, src: withBase(item.src) }));
const galleryGroup = "project-media";
---

<DesktopLayout
  title={data.title}
  description={data.summary}
  section="work"
  activeLabel={data.title}
  image={data.thumbnail}
>
  <WorkIndex projects={projects} inactive />

  <WindowFrame
    client:load
    windowId={`work-${project.id}`}
    title={data.title}
    icon="work"
    path={[{ label: site.desktopLabel, href: "/" }, { label: work.title, href: "/work" }, { label: data.title }]}
    closeHref="/work"
    statusLeft={data.work}
    statusRight={String(data.year)}
    variant="child"
  >
    <article class="window-content work-case">
      <header class="work-case-heading">
        <h1 class="page-title">{data.title}</h1>
        <p class="lead">{data.summary}</p>
      </header>

      <dl class="work-meta">
        <div><dt class="quiet">{work.detail.client}</dt><dd>{data.client}</dd></div>
        <div><dt class="quiet">{work.detail.year}</dt><dd>{data.year}</dd></div>
        <div><dt class="quiet">{work.detail.work}</dt><dd>{data.work}</dd></div>
        <div><dt class="quiet">{work.detail.role}</dt><dd>{data.role}</dd></div>
      </dl>

      {(data.liveUrl || data.repoUrl) && (
        <div class="work-resources">
          {data.repoUrl && (
            <a href={data.repoUrl} target="_blank" rel="noopener noreferrer">
              <PixelIcon name="github" size={16} />
              <span>{work.detail.source}</span>
              <PixelIcon name="external" size={14} />
            </a>
          )}
          {data.liveUrl && (
            <a href={data.liveUrl} target="_blank" rel="noopener noreferrer">
              <span>{work.detail.visit}</span>
              <PixelIcon name="external" size={14} />
            </a>
          )}
        </div>
      )}

      <section aria-labelledby="project-gallery-title">
        <h2 class="section-title" id="project-gallery-title">{work.detail.gallery}</h2>
        <div class="work-media" data-single={media.length === 1 ? "true" : undefined}>
          {media.map((item, index) => (
            <figure>
              <a
                class="work-media-link"
                href={item.src}
                data-gallery={galleryGroup}
                data-gallery-index={index}
                data-astro-reload
              >
                <PhosphorPicture class="work-media-image" src={item.src} alt={item.alt} />
                <span class="work-media-control" aria-hidden="true"><PixelIcon name="maximize" size={20} /></span>
              </a>
              {item.caption && <figcaption class="quiet">{item.caption}</figcaption>}
            </figure>
          ))}
        </div>
      </section>
      <GalleryLightbox client:idle items={media} group={galleryGroup} />

      <div class="prose"><Content /></div>

      {nextProject && (
        <nav class="next-project" aria-label={work.detail.next}>
          <p class="quiet">{work.detail.next}</p>
          <a href={withBase(`/work/${nextProject.id}`)} class="section-title">
            {nextProject.data.title}<PixelIcon name="next" size={28} />
          </a>
        </nav>
      )}
    </article>
  </WindowFrame>
</DesktopLayout>
