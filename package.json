{
  "name": "astro-phosphor",
  "version": "1.0.0",
  "description": "A lightweight 100% static 1990s retro pixel OS personal site template built with Astro 5, React 19, and Tailwind CSS v4.",
  "repository": {
    "type": "git",
    "url": "https://github.com/moonoops/astro-phosphor.git"
  },
  "homepage": "https://github.com/moonoops/astro-phosphor#readme",
  "license": "MIT",
  "type": "module",
  "scripts": {
